# ─────────────────────────────────────────────
#  VOLTA — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# Server
PORT=3000
# Public URL of the site (used for CORS and links in emails)
CLIENT_URL=http://localhost:3000

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/volta

# Auth
JWT_SECRET=replace_with_a_long_random_secret_string
ADMIN_PASSWORD=choose_a_strong_admin_password

# AI quotes (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Payments (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Email: Resend is used when RESEND_API_KEY is set
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Volta Studio <hello@yourdomain.com>"
EMAIL_REPLY_TO=hello@yourdomain.com

# Email: SMTP fallback for local development (e.g. a Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here

# Where new-request and contact notifications are sent
NOTIFY_EMAIL=you@gmail.com

# ── Cloudflare R2 (optional) — keeps delivered files safe across redeploys ──
# Leave blank to store delivered files on the local disk instead.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=volta-files
