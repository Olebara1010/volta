# ─────────────────────────────────────────
#  VOLTA STUDIO — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────

# Server
PORT=3000

# JWT secret — change this to a long random string
JWT_SECRET=replace_with_a_long_random_secret_string

# Email (Gmail example — use an App Password, not your real password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password_here

# The address where you want to receive contact/newsletter emails
NOTIFY_EMAIL=you@gmail.com

# Frontend URL (used for CORS — change in production)
CLIENT_URL=http://localhost:3000
